---
import Base from "../layouts/Base.astro";

/* Content lives here as data so copy stays editable in one place.
   Facts and destinations are preserved from the approved career copy;
   change them in the JobHunt career sources first, then synchronize. */

const building = [
  {
    name: "Kogen",
    href: "https://kogen.dev",
    meta: "Open-source development preview",
    say: "I'm developing Kogen, a software-building system designed to turn a shaped feature into an accepted commit through implementation, checks, independent review, and rework.",
    link: { label: "View source", href: "https://github.com/KogenAI/kogen" },
  },
  {
    name: "Combobulate",
    href: "https://combobulate.dev",
    meta: "combobulate.dev",
    say: "A website-building product designed around a conversation in Telegram, with deployment and domain setup in the same workflow.",
  },
  {
    name: "ElixirDrops",
    href: "https://elixirdrops.net",
    meta: "elixirdrops.net",
    say: "A community-driven publishing platform for short notes on Elixir and Phoenix.",
  },
  {
    name: "Skeptic.bot",
    href: "https://skeptic.bot",
    meta: "skeptic.bot",
    say: "A podcast research assistant built with Elixir and Phoenix LiveView. It turns long episodes into something you can search instead of scrub through.",
  },
];

const openSource = [
  {
    key: "phx.tools",
    href: "https://phx.tools",
    say: "Sets up an Elixir and Phoenix development environment on Linux or macOS with one command.",
  },
  {
    key: "github_workflows_generator",
    href: "https://hex.pm/packages/github_workflows_generator",
    say: "Define GitHub Actions workflows in Elixir and generate the YAML.",
  },
  {
    key: "optimum_credo",
    href: "https://hex.pm/packages/optimum_credo",
    say: "The Credo checks we wanted on our own projects, covering readability, test assertions, and LiveView patterns.",
  },
  {
    key: "Elixir DevOps series",
    href: "https://optimum.ba/blog/elixir-devops-series/",
    say: "Six articles on the CI/CD work that usually gets skipped: caching, release tests, preview apps, deployments, and generated infrastructure.",
  },
];

const history = [
  {
    when: "2022–",
    name: "Optimum Tech",
    say: "Optimum Tech is the company behind my software projects. From 2022 to January 2026, I ran Optimum BH, an Elixir and Phoenix agency, leading delivery, technical direction, CI/CD, code review, and team development. My focus is now software products and developer tooling, including Kogen.",
  },
  {
    when: "2020–24",
    name: "StoryDeck",
    say: "I joined to build a proof of concept, took it through MVP and into production, then stayed as co-founder and technical lead.",
  },
  {
    when: "2019–",
    name: "Contract work",
    say: "Twenty-one contracts and more than 4,500 hours. The work included WPA3 support for Nerves on a Raspberry Pi 4, real-time IoT analytics, an esports matchmaking backend, and replacing a legacy PHP service with Elixir services.",
  },
  {
    when: "2012–20",
    name: "Earlier",
    say: "I worked on the backend at Mukuru, a pan-African remittances company, mostly in PHP with domain-driven design and plenty of legacy code. Before that I was full-stack at Klika and Social Eddy.",
  },
];

const elsewhere = [
  { label: "Email", href: "mailto:almir@optimum.ba" },
  { label: "GitHub", href: "https://github.com/almirsarajcic" },
  { label: "X", href: "https://x.com/ultrathinktrash" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/almir-sarajčić-8911b4429",
  },
];

const no = (i: number) => String(i + 1).padStart(2, "0");
---

<Base>
  <header class="masthead wrap">
    <div class="who">
      <a class="name" href="/">Almir Sarajčić</a>
      <span class="label">Senior software engineer</span>
    </div>
    <nav aria-label="Sections">
      <a href="#building">Building</a>
      <a href="#open-source">Open source</a>
      <a href="#history">History</a>
      <a href="#consulting">Consulting</a>
      <a href="/Almir_Sarajcic_CV.pdf">CV (PDF)</a>
    </nav>
  </header>

  <main id="main">
    <section class="opening wrap">
      <h1>I build software and better workflows for coding agents.</h1>

      <p class="lede">
        I build software and help teams design more reliable ways to work with
        coding agents: shape the feature, define the boundaries, and check the
        result.
      </p>

      <p class="body">
        I started writing software in 2012 and moved to Elixir in 2017. Before
        agents, I spent years working on CI, static analysis, and test
        infrastructure. I now use the same machinery to catch what agents get
        wrong. Models are good at producing plausible code; the surrounding
        system has to decide whether it belongs in production.
      </p>

      <ul class="facts">
        <li><b>Kenya · UTC+3</b></li>
        <li><b>Elixir since 2017</b></li>
        <li><b>Bosnian · English</b></li>
      </ul>

      <div class="actions">
        <a class="button" href="mailto:almir@optimum.ba">Let’s talk</a>
        <a class="textlink" href="/Almir_Sarajcic_CV.pdf">Download the CV (PDF)</a>
      </div>
    </section>

    <section class="section wrap" id="building" aria-labelledby="building-h">
      <div class="head">
        <h2 id="building-h">Building</h2>
        <p>
          Products and tools I develop under Optimum Tech, LLC. Kogen is the
          current focus.
        </p>
      </div>

      <ul>
        {
          building.map((item, i) => (
            <li class="entry">
              <span class="no" aria-hidden="true">
                {no(i)}
              </span>
              <div>
                <h3>
                  <a href={item.href}>{item.name}</a>
                </h3>
                <span class="label meta">{item.meta}</span>
              </div>
              <div>
                <p class="say">{item.say}</p>
                {item.link && (
                  <a class="textlink" href={item.link.href}>
                    {item.link.label} ↗
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section wrap" id="open-source" aria-labelledby="oss-h">
      <div class="head">
        <h2 id="oss-h">Open source</h2>
        <p>
          Tooling and writing released for other Elixir and Phoenix teams to
          use.
        </p>
      </div>

      <ul>
        {
          openSource.map((item, i) => (
            <li class="entry tight">
              <span class="no" aria-hidden="true">
                {no(i)}
              </span>
              <span class="key">
                <a href={item.href}>{item.key}</a>
              </span>
              <p class="say">{item.say}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section wrap" id="history" aria-labelledby="history-h">
      <div class="head">
        <h2 id="history-h">History</h2>
        <p>Where the work has happened, most recent first.</p>
      </div>

      <ol>
        {
          history.map((item, i) => (
            <li class="entry event">
              <span class="no" aria-hidden="true">
                {no(i)}
              </span>
              <span class="when">{item.when}</span>
              <div>
                <span class="name">{item.name}</span>
                <p class="say">{item.say}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="consulting wrap" id="consulting" aria-labelledby="cons-h">
      <div class="panel">
        <h2 id="cons-h">Engineering workflow consulting</h2>
        <div>
          <p>
            I help teams improve how they work with coding agents: shaping
            features before implementation, choosing where autonomy is
            appropriate, and designing checks and independent review. We can
            start with a review of one workflow or a focused pilot around one
            real feature. My work on Kogen informs the approach; the engagement
            starts with your team's delivery problem.
          </p>
          <a class="textlink" href="mailto:almir@optimum.ba">
            Discuss your engineering workflow →
          </a>
        </div>
      </div>
    </section>

    <section class="closing wrap" aria-labelledby="closing-h">
      <h2 id="closing-h">Let’s talk.</h2>
      <div>
        <p>
          For engineering opportunities or a conversation about your team’s
          development workflow, contact me by email.
        </p>
        <a class="mail" href="mailto:almir@optimum.ba">almir@optimum.ba →</a>
      </div>
    </section>
  </main>

  <footer class="site-foot wrap">
    <ul>
      {
        elsewhere.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <span class="label colophon">Set in IBM Plex</span>
  </footer>
</Base>
