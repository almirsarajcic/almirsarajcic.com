---
import AgentMetadata from '../components/AgentMetadata.astro';
import "../styles/site.css";
import regularFont from "../assets/fonts/IBMPlexSans-Regular.woff2?url";
import boldFont from "../assets/fonts/IBMPlexSans-SemiBold.woff2?url";

interface Props {
  title?: string;
  description?: string;
  analytics?: boolean;
}

const {
  analytics = true,
  title = "Almir Sarajčić",
  description = "Elixir and Phoenix consulting, practical AI features, and development workflows. Founder of Optimum Tech. Building Kogen.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, "https://almirsarajcic.com").href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://almirsarajcic.com/#person",
  name: "Almir Sarajčić",
  description,
  url: "https://almirsarajcic.com/",
  jobTitle: "Software Consultant",
  email: "mailto:consulting@optimum.ba",
  address: { "@type": "PostalAddress", addressCountry: "KE" },
  sameAs: [
    "https://github.com/almirsarajcic",
    "https://x.com/ultrathinktrash",
    "https://elixirdrops.net",
    "https://stackoverflow.com/users/920303",
    "https://hex.pm/users/almirsarajcic",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://almirsarajcic.com/brand/social-preview.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@ultrathinktrash" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={regularFont}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={boldFont}
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(person)}
    />
    <!-- Privacy-friendly analytics by Plausible; loaded on the production host only. -->
    {analytics && <script is:inline id="site-analytics">
      if (
        location.hostname === "almirsarajcic.com" ||
        location.hostname === "www.almirsarajcic.com"
      ) {
        window.plausible =
          window.plausible ||
          function () {
            (window.plausible.q = window.plausible.q || []).push(arguments);
          };
        window.plausible.init =
          window.plausible.init ||
          function (i) {
            window.plausible.o = i || {};
          };
        window.plausible.init();
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://plausible.io/js/pa-A5MB5OkBYFQH-mJTI8D5n.js";
        document.head.appendChild(s);
      }
    </script>}
  <AgentMetadata /></head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
