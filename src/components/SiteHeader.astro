---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
---
<header class="compact-header">
  <div class="compact-wrap header-content">
    {home ? <h1>Almir Sarajčić</h1> : <a class="name" href="/">Almir Sarajčić</a>}
    <a class="download" href="/Almir_Sarajcic_CV.pdf" download>Download CV (PDF)</a>
  </div>
</header>

<style>
  .compact-header {
    border-bottom: 1px solid var(--rule);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-block: 13px;
  }

  h1,
  .name {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .download {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 7px 12px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--accent-ink);
    white-space: nowrap;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .download:hover {
    text-decoration: underline;
  }

  @media (max-width: 370px) {
    h1,
    .name {
      font-size: 1.23rem;
    }

    .download {
      padding-inline: 8px;
    }
  }
</style>
